<Window x:Class="BorDer_PR9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR9"
        mc:Ignorable="d"
        Title="Магазин книг" Height="650" Width="1000"
        FontFamily="Segoe UI" FontSize="16">
    <StackPanel Orientation="Horizontal" 
                Margin="20" 
                Background="AliceBlue" 
                MinWidth="450">
        <ListView x:Name="listView" 
                  Margin="20" 
                  SelectionChanged="listView_SelectionChanged" >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" 
                                 HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" 
                                Margin="5"
                                HorizontalAlignment="Center">
                        <Image Source="{Binding Изображение}" 
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Название}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   FontWeight="SemiBold" 
                                   MaxWidth="150"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Width="300" Margin="20,0,10,0" x:Name="gridDescription" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="imgBook" 
                   Grid.Row="0"
                   Stretch="Uniform" 
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>
            
            <TextBlock Text="Описание"
                       Margin="0.5"
                       Grid.Row="1" 
                       FontWeight="Bold"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <TextBlock x:Name="textDescription" 
                       TextWrapping="Wrap" 
                       LineHeight="20" />
            </ScrollViewer>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Цена: " FontWeight="Bold" Margin="0,0,5,0" />
                <TextBlock x:Name="textPrice" Foreground="DarkSlateGray" />
                <TextBlock Text=" ₽" />
            </WrapPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Количество" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="btnDecrease" Content="-" Width="25" Height="25" Click="Button_Click"/>
                <TextBox x:Name="tbCount" Width="70" Height="25" Margin="5,0" TextAlignment="Center" Text="1" TextChanged="tbCount_TextChanged" />
                <Button x:Name="btnIncrease" Content="+" Width="25" Height="25" Click="Button_Click"/>
            </StackPanel>

            <Button Grid.Row="5" 
                    Content="Оформить заказ" 
                    Padding="10,5" 
                    HorizontalAlignment="Center" 
                    Width="150" 
                    x:Name="createOrder"
                    Click="createOrder_Click"/>
        </Grid>
    </StackPanel>
</Window>
